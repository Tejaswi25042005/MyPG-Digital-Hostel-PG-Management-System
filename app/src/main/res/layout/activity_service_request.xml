<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F4F6FB"
    tools:context=".servicerequests.ServiceRequestActivity">

    <!-- ================= HEADER ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#3F51B5"
        app:cardElevation="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- BACK -->
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_back"
                android:tint="@android:color/white"
                android:contentDescription="Back" />

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:text="Service Requests"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchServiceRequests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                app:thumbTint="@android:color/white"
                app:trackTint="#B3FFFFFF" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= FILTERS ================= -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardHeader"
        android:scrollbars="none"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="All"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:background="#3F51B5"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Open"
                android:textSize="13sp"
                android:textColor="#333"
                android:background="#E0E0E0"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="In Progress"
                android:textSize="13sp"
                android:textColor="#333"
                android:background="#E0E0E0"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filterResolved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Resolved"
                android:textSize="13sp"
                android:textColor="#333"
                android:background="#E0E0E0" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ================= REQUEST LIST ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServiceRequests"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterScroll"
        android:padding="12dp"
        tools:listitem="@layout/item_owner_service_request" />

    <!-- ================= EMPTY STATE ================= -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterScroll"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_service"
            android:tint="#AAA" />

        <TextView
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No service requests"
            android:textSize="14sp"
            android:textColor="#777" />
    </LinearLayout>

</RelativeLayout>
