<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp">

        <!-- AVATAR -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_avatar"
            android:text="R"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center" />

        <!-- STATUS -->

        <!-- TENANT NAME -->

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_status_badge_red"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="OPEN"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTenantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tvAvatar"
            android:layout_marginTop="2dp"
            android:layout_marginStart="12dp"
            android:text="Ravi Kumar"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <!-- ISSUE TITLE -->
        <TextView
            android:id="@+id/tvIssueTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tvAvatar"
            android:layout_marginStart="12dp"
            android:layout_below="@id/tvTenantName"
            android:layout_marginTop="8dp"
            android:text="Water leakage in bathroom"
            android:textSize="13sp"
            android:textColor="#555555"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- DATE -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStatus"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:text="12 Feb 2026"
            android:textSize="11sp"
            android:textColor="@color/black" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
