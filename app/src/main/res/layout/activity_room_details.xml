<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB"
    tools:context=".rooms.RoomDetailsActivity">

    <!-- ================= HEADER ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/primary">

        <TextView
            android:id="@+id/tvRoomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Room 101"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>
    </androidx.cardview.widget.CardView>

    <!-- ================= ROOM INFO ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRoomInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardHeader"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvFloorInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floor: 1"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBedsInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Beds: 4 | Free: 2"
                android:textSize="14sp"
                android:textColor="#555"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ================= TENANTS LIST ================= -->
    <TextView
        android:id="@+id/tvTenantsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardRoomInfo"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Tenants"
        android:textStyle="bold"
        android:textSize="16sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTenants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvTenantsLabel"
        android:layout_margin="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

</RelativeLayout>
