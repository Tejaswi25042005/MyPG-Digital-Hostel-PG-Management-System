<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- AVATAR -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_avatar"
            android:text="S"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="30dp"
            android:gravity="center" />

        <!-- TENANT NAME -->
        <TextView
            android:id="@+id/tvTenantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tvAvatar"
            android:layout_marginStart="12dp"
            android:text="Srikanta Dussa"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <!-- MOBILE -->
        <TextView
            android:id="@+id/tvTenantMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTenantName"
            android:layout_toEndOf="@id/tvAvatar"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:text="📞 8977501906"
            android:textSize="13sp"
            android:textColor="#757575" />

        <!-- ROOM INFO (CHIP STYLE) -->
        <TextView
            android:id="@+id/tvTenantRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Floor 1 • Room 101"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="#E8EAF6" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
