<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ===== TOP ROW ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tenant Icon -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/primary"/>

            <!-- Tenant Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- Tenant Name -->
                <TextView
                    android:id="@+id/tvTenantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ravi Kumar"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000"/>

                <!-- Tenant Mobile -->
                <TextView
                    android:id="@+id/tvTenantMobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 9876543210"
                    android:textSize="13sp"
                    android:textColor="#555"
                    android:layout_marginTop="2dp"/>

                <!-- Requested Date -->
                <TextView
                    android:id="@+id/tvRequestedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requested on 12 Jan 2026"
                    android:textSize="12sp"
                    android:textColor="#777"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <!-- ===== DETAILS ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvSharing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Sharing"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333"/>

            <TextView
                android:id="@+id/tvRent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · ₹8,000"
                android:textSize="14sp"
                android:textColor="#333"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
