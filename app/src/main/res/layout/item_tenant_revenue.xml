<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Tenant Name -->
        <TextView
            android:id="@+id/tvTenantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rahul Kumar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Tenant Type -->
        <TextView
            android:id="@+id/tvTenantType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTenantName"
            android:layout_marginTop="2dp"
            android:text="Student"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <!-- Room Info -->
        <TextView
            android:id="@+id/tvRoomInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTenantType"
            android:layout_marginTop="4dp"
            android:text="Room 101 • Double Sharing"
            android:textSize="13sp"
            android:textColor="#666666" />

        <!-- Rent Amount -->
        <TextView
            android:id="@+id/tvRentAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₹8,000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Payment Status -->
        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvRentAmount"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="4dp"
            android:text="PAID"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/tvRoomInfo"
            android:layout_marginTop="10dp"
            android:background="#EEEEEE" />

        <!-- Payment Summary -->
        <TextView
            android:id="@+id/tvPaymentSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/divider"
            android:layout_marginTop="8dp"
            android:text="Collected: ₹8,000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
