<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- ===== BEDS VISUAL INDICATOR ===== -->
        <LinearLayout
            android:id="@+id/layoutBeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_centerInParent="true">

            <!-- These ImageViews will be added dynamically in adapter -->
            <!-- Example only -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_bed_green" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_bed_red" />
        </LinearLayout>

        <!-- ===== ROOM NUMBER ===== -->
        <TextView
            android:id="@+id/tvRoomNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutBeds"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="Room 101"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#000" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
