<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#F5F6FA" />

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#D1D5DB" />

    <!-- Rounded corners -->
    <corners android:radius="10dp" />

    <!-- Padding -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="36dp"
        android:bottom="12dp" />
</shape>
